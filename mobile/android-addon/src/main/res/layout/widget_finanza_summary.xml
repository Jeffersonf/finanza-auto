<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_open"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/finanza_widget_background"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="finanza. VEICULO"
            android:textColor="#C8F55A"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_quick_fuel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="+ Abastecer"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="R$ 0,00"
        android:textColor="#F5F7FB"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_count"
        android:layout_width="wrap_content"
         android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="0 registros no carro"
        android:textColor="#9AA4B5"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Finanza Next OLED"
        android:textColor="#5AF5C8"
        android:textSize="10sp"

        android:textStyle="bold" />
</LinearLayout>